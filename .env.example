# Copie este arquivo para .env.local e preencha com os valores reais.

# Crie uma conta gratuita em https://resend.com e gere uma API key em
# https://resend.com/api-keys (o plano free permite até 3.000 e-mails/mês).
RESEND_API_KEY=

# Senha de acesso ao painel /admin/dashboard.
ADMIN_PASSWORD=

# Chave usada para assinar o cookie de sessão do admin. Gere uma aleatória com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# String de conexão do Postgres (Neon). É preenchida automaticamente quando
# a integração Neon é conectada ao projeto na Vercel (vercel integration add neon).
DATABASE_URL=
